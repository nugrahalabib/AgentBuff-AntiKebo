# Env Tuya MCP. Salin ke .env.local untuk pengembangan.
# Aplikasi MENOLAK menyala bila yang wajib kosong.
DATABASE_URL=postgres://tuya_app:ganti@localhost:5432/tuya
DATABASE_URL_MIGRASI=postgres://tuya_migrasi:ganti@localhost:5432/tuya
APP_ORIGIN=http://localhost:3100
SESSION_SECRET=isi-minimal-32-karakter-acak-................
# Kunci utama enkripsi kunci Tuya (base64 32 byte): openssl rand -base64 32
ENCRYPTION_KEK=
AGENTBUFF_ISSUER=https://agentbuff.id/masuk
AGENTBUFF_ORIGIN=https://agentbuff.id
AGENTBUFF_PRODUCT_KEY=tuya-mcp
# Klien pengembangan TERPISAH (tuya-dev, redirect localhost).
AGENTBUFF_MASUK_CLIENT_ID=tuya-dev
AGENTBUFF_MASUK_CLIENT_SECRET=
LOG_LEVEL=info
# Hanya untuk uji: alamat server Tuya tiruan (kosong = server Tuya asli sesuai wilayah kunci).
TUYA_BASIS_UJI=
