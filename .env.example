# Env AntiKebo. Untuk pengembangan, `bash scripts/siapkan-lokal.sh` membuat .env.local berisi
# nilai acak + server tiruan AgentBuff (dijalankan otomatis di sesi cloud). Aplikasi MENOLAK
# menyala bila yang wajib kosong (src/lib/env.ts). Daftar & artinya: docs/03-ARSITEKTUR.md §12.

# ---- Basis data (peran tanpa BYPASSRLS; web = antikebo_app, worker = antikebo_worker)
DATABASE_URL=postgres://antikebo_app:ganti@127.0.0.1:5432/antikebo
# Hanya untuk migrasi (pemilik tabel, bukan superuser).
DATABASE_URL_MIGRASI=postgres://antikebo_migrasi:ganti@127.0.0.1:5432/antikebo
# Untuk worker saat pengembangan (produksi: compose mengisi DATABASE_URL worker).
DATABASE_URL_WORKER=postgres://antikebo_worker:ganti@127.0.0.1:5432/antikebo

# ---- Aplikasi
APP_ORIGIN=http://localhost:3100
# Minimal 32 karakter acak: openssl rand -hex 32
SESSION_SECRET=
# Kunci utama enkripsi amplop (base64 32 byte): openssl rand -base64 32
ENCRYPTION_KEK=
LOG_LEVEL=info
# Batas pemeriksaan hak ke AgentBuff per proses per detik (bawaan 4; compose: web 4, worker 2).
ANTIKEBO_HAK_LAJU_PER_DTK=

# ---- AgentBuff (Masuk dengan AgentBuff, cek hak, MCP otomatis, pintu kanal/pesan/suara)
AGENTBUFF_ISSUER=https://agentbuff.id/masuk
AGENTBUFF_ORIGIN=https://agentbuff.id
AGENTBUFF_PRODUCT_KEY=antikebo
# Produksi: antikebo. Pengembangan dengan AgentBuff asli: antikebo-dev (redirect localhost).
AGENTBUFF_MASUK_CLIENT_ID=antikebo-dev
AGENTBUFF_MASUK_CLIENT_SECRET=
# 1 = pintu kanal/pesan/suara memakai server tiruan (tests/tiruan/agentbuff.ts, `pnpm tiruan`).
# Hanya boleh dengan APP_ORIGIN localhost. Bila issuer juga diarahkan ke tiruan, masuk pun tiruan.
AGENTBUFF_TIRUAN=
# Alamat server tiruan (bawaan: sama dengan AGENTBUFF_ISSUER).
AGENTBUFF_TIRUAN_URL=
# Server Tuya tiruan (pengembangan/uji, `pnpm tiruan`). Diabaikan bila AGENTBUFF_TIRUAN bukan 1.
TUYA_BASIS_UJI=

# ---- Notifikasi web (wajib sejak P6): npx web-push generate-vapid-keys (siapkan-lokal.sh membuatnya otomatis)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operator@agentbuff.id

# ---- Operasional
# Tujuan pemberitahuan operator (detak worker basi, kegagalan beruntun).
OPERATOR_KABAR=
# Folder pemasang aplikasi PC yang disajikan di /unduh/pc/* (bawaan ./unduh; docs/09 §8).
# Kunci publik pembaruan PC tertanam di aplikasinya (pc/src-tauri/tauri.conf.json), bukan di sini.
UNDUH_DIR=

# ---- Kata sandi peran DB (deploy/docker-compose.yml dan scripts/siapkan-lokal.sh)
ANTIKEBO_SUPER_PASSWORD=
ANTIKEBO_MIGRASI_PASSWORD=
ANTIKEBO_APP_PASSWORD=
ANTIKEBO_WORKER_PASSWORD=
