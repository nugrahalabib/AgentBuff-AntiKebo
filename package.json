{
  "name": "antikebo",
  "version": "0.1.0",
  "private": true,
  "description": "AntiKebo: alarm anti kesiangan untuk Marketplace AgentBuff. Tidak berhenti sampai soal terjawab.",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev --turbopack -p 3100",
    "build": "node scripts/jaga.mjs && next build",
    "start": "next start -p 3100",
    "jaga": "node scripts/jaga.mjs",
    "lint": "eslint src scripts tests",
    "tsc": "tsc --noEmit",
    "format": "prettier --write .",
    "format:cek": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrasi.ts",
    "worker": "tsx --env-file-if-exists=.env.local src/worker/index.ts",
    "tiruan": "tsx --env-file-if-exists=.env.local tests/tiruan/jalankan.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@modelcontextprotocol/server": "2.0.0",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.1.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.7.0",
    "next": "16.3.6",
    "openid-client": "^6.8.8",
    "pino": "^9.9.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "3.6.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@breezystack/lamejs": "^1.2.7",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "fast-check": "^4.10.2",
    "http_ece": "1.2.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
